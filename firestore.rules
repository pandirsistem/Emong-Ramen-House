rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pandircmss@gmail.com' ||
        request.auth.token.email == 'firman@emongramen.com' ||
        request.auth.token.email.matches('(?i).*admin.*') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Admins marker collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.token.email == 'pandircmss@gmail.com' ||
        request.auth.token.email == 'firman@emongramen.com' ||
        request.auth.token.email.matches('(?i).*admin.*') ||
        isAdmin()
      );
    }

    // Users profile collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Revoked users
    match /revoked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Closings collection (Uang Masuk / Closing Shift)
    match /closings/{closingId} {
      // All logged in users (admin & cashiers) can read closings so all devices have identical realtime state
      allow read: if isSignedIn();

      // Authenticated users can create closing records
      allow create: if isSignedIn() && isValidId(closingId);

      // Admin or closing creator can update (review, notes, etc.)
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.cashierId == request.auth.uid
      );

      // Only Admin can delete
      allow delete: if isAdmin();
    }

    // Expenses collection (Pengeluaran Operasional)
    match /expenses/{expenseId} {
      // All logged in users can read expenses so balance is identical across PC & HP
      allow read: if isSignedIn();

      // Admin or staff can create expenses
      allow create: if isSignedIn() && isValidId(expenseId);

      // Admin can update or delete expenses
      allow update, delete: if isAdmin();
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow create: if isSignedIn() && isValidId(logId);
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
