rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'pandircmss@gmail.com' ||
        request.auth.token.email == 'firman@emongramen.com'
      );
    }

    function isCashierActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins marker collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      // Allow bootstrapping for the designated admin email or by existing admin
      allow write: if isSignedIn() && isValidId(userId) && (
        request.auth.token.email == 'pandircmss@gmail.com' ||
        request.auth.token.email == 'firman@emongramen.com' ||
        isAdmin()
      );
    }

    // Users profile collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && resource.data.isActive != false && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive', 'status']))
      );
      allow delete: if isAdmin();
    }

    // Revoked users blacklist / audit marker
    match /revoked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Closings collection (Uang Masuk / Closing Shift)
    match /closings/{closingId} {
      // Cashier can read only their own closings; Admin can read all
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource.data.cashierId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.cashierId == request.auth.uid
      );

      // Cashiers can create closing record for themselves only if active
      allow create: if isSignedIn() && isValidId(closingId) && isCashierActive() && (
        request.resource.data.cashierId == request.auth.uid || isAdmin()
      ) && (request.resource.data.status in ['pending', 'approved']);

      // Only Admin can update (review, approve, reject)
      allow update: if isAdmin();

      // Only Admin can delete
      allow delete: if isAdmin();
    }

    // Expenses collection (Pengeluaran Operasional) - Strictly Admin only
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // Audit logs collection (Catatan Aktivitas / Pengawasan)
    match /audit_logs/{logId} {
      // Any authenticated user can create an audit entry
      allow create: if isSignedIn() && isValidId(logId);
      // Strictly Admin can read audit logs
      allow read: if isAdmin();
      // Logs are immutable: no update or delete allowed
      allow update, delete: if false;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
