rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'pandircmss@gmail.com' ||
        request.auth.token.email == 'firman@emongramen.com' ||
        request.auth.token.email.matches('(?i).*admin.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isCashierActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'disabled');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins marker collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(userId) && (
        request.auth.token.email == 'pandircmss@gmail.com' ||
        request.auth.token.email == 'firman@emongramen.com' ||
        request.auth.token.email.matches('(?i).*admin.*') ||
        isAdmin()
      );
    }

    // Users profile collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && resource.data.isActive != false && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive', 'status']))
      );
      allow delete: if isAdmin();
    }

    // Revoked users blacklist / audit marker
    match /revoked_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Closings collection (Uang Masuk / Closing Shift)
    match /closings/{closingId} {
      // All authenticated and active users can read closings so all devices (HP & PC) have matching real-time data
      allow read: if isSignedIn() && isCashierActive();

      // Active cashiers and admins can create closing records
      allow create: if isSignedIn() && isValidId(closingId) && isCashierActive() && (
        request.resource.data.status in ['pending', 'approved']
      );

      // Admin or closing creator can update (review, approve, reject, notes)
      allow update: if isSignedIn() && isCashierActive() && (
        isAdmin() ||
        resource.data.cashierId == request.auth.uid
      );

      // Only Admin can delete
      allow delete: if isAdmin();
    }

    // Expenses collection (Pengeluaran Operasional)
    match /expenses/{expenseId} {
      // All authenticated and active users can read expenses so total balance and expense records sync across all devices
      allow read: if isSignedIn() && isCashierActive();

      // Admin and active staff can create expenses
      allow create: if isSignedIn() && isValidId(expenseId) && isCashierActive();

      // Admin can update or delete expenses
      allow update, delete: if isAdmin();
    }

    // Audit logs collection (Catatan Aktivitas / Pengawasan)
    match /audit_logs/{logId} {
      allow create: if isSignedIn() && isValidId(logId);
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.email == 'firman@emongramen.com' ||
        request.auth.token.email == 'pandircmss@gmail.com'
      );
    }
  }
}
